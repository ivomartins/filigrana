# Cloudflare Pages response headers.
# The CSP is the same policy as the <meta> tag in index.html, plus frame-ancestors
# (which only works as a header). connect-src 'none' means the page is technically
# unable to send anything anywhere — that is the tool's whole promise.
#
# Cache-Control carries no-transform on every response. It tells any intermediary, Cloudflare
# included, not to modify the payload; Cloudflare honours it by not injecting anything into
# the HTML (bot-detection scripts, analytics beacons, obfuscation). What the browser receives
# is what is in this repository, byte for byte, and no dashboard setting can change that.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; font-src 'self'; worker-src 'self' blob:; manifest-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=14400, must-revalidate, no-transform

# HTML pages are never cached, so a deploy is visible at once (the Pages default, plus no-transform).
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacidade
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/404
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Vendored libraries carry their version in the path (vendor/pdfjs-6.3.289/…), so they can be
# cached for a year: a new version is a new path. Keeps PDFs working offline long after a visit.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable, no-transform
