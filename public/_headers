# Cloudflare Pages response headers.
# The CSP is the same policy as the <meta> tag in index.html, plus frame-ancestors
# (which only works as a header). connect-src 'none' means the page is technically
# unable to send anything anywhere — that is the tool's whole promise.
#
# Rule mechanics (verified on a preview deploy): when several rules match a path, Pages joins
# the values of a header set by more than one of them, so Cache-Control must be set by exactly
# one rule per path. The check enforces it.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; font-src 'self'; worker-src 'self' blob:; manifest-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# HTML pages: never cached (a deploy is visible at once) and never transformed. no-transform is
# the HTTP-standard instruction that no intermediary may modify the payload; Cloudflare honours
# it by injecting nothing into the HTML (bot-detection scripts, analytics beacons, obfuscation).
# What the browser receives is what is in this repository, byte for byte, whatever the dashboard
# says. Only on HTML: on other files it would also disable compression, and injection never
# touches them.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacidade
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/404
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Vendored libraries carry their version in the path (vendor/pdfjs-6.3.289/…), so they can be
# cached for a year: a new version is a new path. Keeps PDFs working offline long after a visit.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
